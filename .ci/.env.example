# fcloud-ci-hub 单镜像环境变量
# 用法：cp .ci/.env.example .ci/.env，按下表填好后再 `docker compose -f .ci/docker-compose.yml up -d`
# 注意：.env 含密钥，已加入 .gitignore，不要提交。

# ---- 必填 ----
# GitLab 实例根地址（OAuth 的 authorize / token / userinfo 都基于它）
FCLOUD_GITLAB_BASE_URL=https://gitlab.example.com
FCLOUD_GITLAB_CLIENT_ID=
FCLOUD_GITLAB_CLIENT_SECRET=
# JWT 签名密钥，≥32 字符；换掉等于让所有已登录会话失效
FCLOUD_JWT_SECRET=

# ---- 可选：镜像与端口 ----
# FCLOUD_IMAGE=fcloud-ci-hub:latest
# FCLOUD_HTTP_PORT=8080

# ---- 可选：数据库（内置 PG，仅容器内访问）----
# ⚠️ 首次启动会按这里的值 initdb 建角色；之后改密码不会自动生效，
#    需要用 psql 改角色密码（或删卷重来，但会丢数据）。
# FCLOUD_DB_NAME=fcloud_ci_hub
# FCLOUD_DB_USER=fcloud
# FCLOUD_DB_PASSWORD=fcloud

# ---- 可选：运行时行为 ----
# 生产走 HTTPS 时务必设 true（Cookie 带 Secure）
# FCLOUD_COOKIE_SECURE=true
# FCLOUD_BACKUP_RETAIN=3
# FCLOUD_AUDIT_RETAIN_DAYS=7
# FCLOUD_ACCESS_LOG_RETAIN_DAYS=30
# FCLOUD_RATE_LIMIT_PER_MINUTE=60
# 显式提供主密钥（Base64 32 字节）；不填则首启自动生成到 /data/config-hub/master.key
# FCLOUD_MASTER_KEY=

# ---- 可选：MCP ----
# 总开关默认 true；置 false 时 /mcp 直接 404
# FCLOUD_MCP_ENABLED=true
# 写工具与明文读取默认关闭，需要显式打开（且令牌要有对应 scope）
# FCLOUD_MCP_WRITE_ENABLED=false
# FCLOUD_MCP_REVEAL_ENABLED=false
